# Dependencies and generated Angular output
node_modules/
/.angular/
/dist/
/out-tsc/
/coverage/
*.tsbuildinfo

# Generated browser test output (keep test source and fixtures)
/artifacts/
/playwright-report/
/test-results/
/blob-report/

# Local environment variables (keep shareable examples)
.env
.env.*
!.env.example
!.env.*.example
!.env.sample

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo
*~
/tmp/

# Python cache generated by agent helpers
__pycache__/
*.py[cod]
.venv/

# Local agent connections and backups (keep project instructions and skills)
/.agents/mcp_config.json
/.agents/mcp_config.backup-*.json
/agent-backups/

# Editor state (keep shared project configuration)
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/
*.sublime-workspace

# Operating system metadata
.DS_Store
Thumbs.db
Desktop.ini
